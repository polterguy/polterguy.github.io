{
  "name": "strings.to-upper",
  "description": "Transforms input text to uppercase",
  "signature": {
    "input": {
      "kind": "text",
      "description": "Text to transform",
      "required": true,
      "mode": "ValueOrExpression"
    },
    "output": {
      "mode": "Value",
      "kind": "text",
      "description": "Resolves to the uppercased string"
    }
  }
}
