{
  "name": "openai.whisper",
  "description": "Transcribes audio content using OpenAI Whisper",
  "signature": {
    "children": {
      "key": {
        "type": "string",
        "kind": "openai-api-key",
        "description": "OpenAI API key",
        "required": true,
        "mode": "ValueOrExpression",
        "cardinality": "ExactlyOne",
        "role": "Option",
        "projection": "Value"
      },
      "content": {
        "type": "byte[]",
        "kind": "binary-content",
        "description": "Audio content bytes",
        "required": true,
        "mode": "ValueOrExpression",
        "cardinality": "ExactlyOne",
        "role": "Option",
        "projection": "Value"
      },
      "type": {
        "type": "string",
        "kind": "content-type",
        "description": "Audio MIME type",
        "required": true,
        "mode": "ValueOrExpression",
        "cardinality": "ExactlyOne",
        "role": "Option",
        "projection": "Value"
      },
      "language": {
        "type": "string",
        "kind": "language-code",
        "description": "Optional language hint",
        "required": false,
        "mode": "ValueOrExpression",
        "cardinality": "ZeroOrOne",
        "role": "Option",
        "projection": "Value"
      }
    },
    "output": {
      "mode": "Value",
      "kind": "text",
      "description": "Resolves to the transcribed text"
    }
  }
}
