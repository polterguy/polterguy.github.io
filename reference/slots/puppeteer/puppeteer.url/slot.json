{
  "name": "puppeteer.url",
  "description": "Returns the current page URL",
  "signature": {
    "input": {
      "kind": "puppeteer-session",
      "description": "Puppeteer session ID",
      "required": true,
      "mode": "ValueOrExpression"
    },
    "scope": {
      "requires": "puppeteer-session"
    },
    "output": {
      "mode": "Value",
      "kind": "url,text",
      "description": "Resolves to the current page URL"
    }
  }
}
