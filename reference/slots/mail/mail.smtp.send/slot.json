                "values": [
                  "content"
                ],
                "kind": "Excludes"
              },
              {
                "description": "Leaf MIME parts must not contain nested [entity] children",
                "value-pattern": "^(?!multipart/).+/.+$",
                "values": [
                  "entity"
                ],
                "kind": "Excludes"
              },
              {
                "description": "Leaf MIME parts require either [content] or [filename]",
