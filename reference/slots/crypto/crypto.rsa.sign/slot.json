{
  "name": "crypto.rsa.sign",
  "description": "Signs data using RSA",
  "signature": {
    "input": {
      "kind": "text,binary-content",
      "description": "Content to sign",
      "required": true,
      "mode": "ValueOrExpression"
    },
    "children": {
      "private-key": {
        "type": "string|byte[]",
        "kind": "rsa-private-key",
        "description": "Private key for the RSA operation",
        "required": true,
        "mode": "ValueOrExpression",
        "cardinality": "ExactlyOne",
        "role": "Option",
        "projection": "Value"
      },
      "raw": {
        "type": "bool",
        "description": "Whether to return raw bytes instead of encoded text",
        "required": false,
        "mode": "ValueOrExpression",
        "cardinality": "ZeroOrOne",
        "default": "false",
        "role": "Option",
        "projection": "Value"
      }
    },
    "output": {
      "mode": "Value",
      "kind": "rsa-signature,fingerprint-source",
      "description": "Resolves to the signature as base64 text or raw bytes when [raw] is true"
    }
  }
}
